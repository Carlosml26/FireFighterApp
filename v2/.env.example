# Reference only: this application does not automatically load .env files.
# Export these values in your shell or use the commands in docs/installation.md.
HOST=127.0.0.1
PORT=4318
# Relative to the execution directory (run npm start from v2/).
DB_PATH=./data/brigada.sqlite
# Seeds fictional data only when both units and incidents are empty.
# 0 disables seeding; it never deletes existing data.
TRAINING=1
